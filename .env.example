# ELDER GUARD - Configuration
# Rename this file to .env and fill in your credentials

# Email Alert Configuration
# Using Gmail: Create an "App Password" in your Google Account security settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Application Settings
DEBUG=0
SECRET_KEY=elder-guard-secret-key-123
DATABASE_URL=sqlite:///db.sqlite

# System Preferences
ALERT_COOLDOWN=10
FPS_LIMIT=30
RESOLUTION=640x480
